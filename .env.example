# Shared
NODE_ENV=development
# Local development example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manzil
# Supabase direct Postgres example. Replace placeholders in your real .env only.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.wfabehnihelxemztmvca.supabase.co:5432/postgres?sslmode=require
REDIS_URL=redis://localhost:6379
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_SUPABASE_URL=https://wfabehnihelxemztmvca.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/uz/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/uz/sign-up
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# API
PORT=4000
# Local-only role fallback. Production admin access must use real auth.
MANZIL_DEV_AUTH=true
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=manzil-media
CLOUDFLARE_R2_PUBLIC_URL=

# Security
# Comma-separated allowlist. A wildcard ("*") makes the API refuse to boot in
# production — credentialed CORS with a wildcard lets any site drive
# authenticated requests.
WEB_ORIGIN=http://localhost:3000

# Error monitoring (optional — the SDK no-ops without a DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Source-map upload at build time. Without SENTRY_ORG + SENTRY_PROJECT the
# Next config skips the Sentry wrapper entirely.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Campaign delivery (CRM M4). Telegram is the primary channel for the
# Uzbekistan market. Without this, CampaignsService reports the channel as
# unconfigured and records sends as failed rather than falsely as sent.
TELEGRAM_BOT_TOKEN=
# SMS is the secondary channel and is deliberately not wired: half-wiring two
# providers leaves neither trustworthy.
SMS_API_URL=
SMS_API_TOKEN=
