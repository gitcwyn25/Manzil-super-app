{
  "name": "manzil-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Manzil local business discovery and reviews platform for Uzbekistan.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @manzil/web",
    "dev:web": "npm run dev --workspace @manzil/web",
    "dev:api": "npm run start:dev --workspace @manzil/api",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace @manzil/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "seed:validate": "tsx tools/validate-seed.ts data/tashkent-seed-template.csv"
  },
  "devDependencies": {
    "prisma": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
