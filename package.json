{
  "name": "manzil-platform",
  "private": true,
  "version": "0.2.0",
  "description": "Manzil local business discovery and reviews platform for Uzbekistan.",
  "workspaces": [
    "packages/shared",
    "packages/db",
    "apps/api",
    "apps/web",
    "apps/admin",
    "apps/mobile",
    "marketing-office/telegram-bot"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @manzil/web",
    "dev:web": "npm run dev --workspace @manzil/web",
    "dev:api": "npm run start:dev --workspace @manzil/api",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace @manzil/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "prisma generate --schema packages/db/schema.prisma",
    "db:migrate": "npm run migrate:dev --workspace db",
    "db:migrate:deploy": "npm run migrate:deploy --workspace db",
    "db:push": "npm run db:push --workspace db",
    "db:seed": "tsx packages/db/prisma/seed.ts",
    "prisma:generate": "npm run db:generate",
    "prisma:migrate": "npm run db:migrate",
    "seed:validate": "tsx tech-office/tools/validate-seed.ts data/tashkent-seed-template.csv",
    "doctor": "npx react-doctor@latest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:api": "npm run test --workspace @manzil/api"
  },
  "prisma": {
    "seed": "tsx packages/db/prisma/seed.ts"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.32",
    "@playwright/test": "^1.62.1",
    "prisma": "6.19.3",
    "tsx": "latest",
    "typescript": "latest",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@openrouter/sdk": "^0.13.20",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "gsap": "^3.15.0",
    "motion": "^13.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3"
  }
}
