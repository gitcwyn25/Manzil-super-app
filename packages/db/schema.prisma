/// (which mints the delegate on every image build) cannot switch it on by
/// accident.
///
/// Deliberately generic: one table for all six tiers, because the tier
/// vocabulary is a TypeScript union (`MemoryTier`) and a table per tier would
/// make every new tier a migration.
model MemoryObject {
  id String @id @default(cuid())

  /// `MemoryTier`: mission_context, preference_context, relationship_context,
  /// workspace_timeline, business_context, marketplace_context.
  tier      String
  /// Who or what the memory is *about*: a customer (tiers 1-3, 5), a
  /// workspace (tier 4), or the market itself (tier 6).
  subjectId String
  /// Derived from (tier, subjectId) and stable across rewrites, so the
  /// `memoryIds consulted` on a recommendation (doc 23 §9) still resolve
  /// after the memory changes.
  memoryId  String @unique

  /// `KnowledgeSource` (core/core.primitives): conversation, booking, visit…
  /// `conversation` means facts extracted FROM a conversation, never its text.
  source     String
  /// [0, 1]. The migration adds a CHECK constraint the schema cannot express.
  confidence Float

  /// The structured knowledge payload — a typed tier shape, never chat.
  /// `memory.validation.ts` refuses transcript-shaped payloads on the way in
  /// and on the way out.
  knowledge Json @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Null = does not expire on its own (the long-term tiers). Volatile tiers
