  expiresAt DateTime?

  /// Index into the binding tier order (0-5); denormalised so a mixed bag of
  /// memories sorts without re-deriving the contract.
  retrievalPriority Int

  /// One memory per (tier, subject) — the uniqueness that makes writing a
  /// memory twice idempotent, in Postgres as well as in memory.
  @@unique([tier, subjectId])
  @@index([subjectId])
  @@index([expiresAt])
  @@index([tier])
}

