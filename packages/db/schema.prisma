generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  consumer
  business_owner
  admin
}

enum BusinessStatus {
  unclaimed
  pending_claim
  claimed
  suspended
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum ClaimStatus {
  pending
  approved
  rejected
}

enum ReportStatus {
  open
  resolved
  rejected
}

enum AnnouncementKind {
  news
  discount
  broadcast
}

enum AnnouncementStatus {
  draft
  published
  archived
}

enum PlanTier {
  free
  pro
  max
}

enum SubscriptionStatus {
  trial
  active
  invoice_pending
  canceled
}

enum UserStatus {
  active
  suspended
  banned
}

enum StaffRole {
  owner
  manager
  staff
}

enum PaymentProvider {
  payme
  click
  uzcard
  card
  stripe
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum BookingStatus {
  pending
  confirmed
  canceled
  completed
  no_show
}

enum VerificationMethod {
  stir
  document
  phone
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum BusinessEventType {
  view
  call
  directions
  message
  photo_view
}

model User {
  id           String     @id @default(cuid())
  clerkId      String?    @unique
  email        String?    @unique
  phone        String?    @unique
  displayName  String
  avatarUrl    String?
  locale       String     @default("uz")
  role         UserRole   @default(consumer)
  status       UserStatus @default(active)
  bannedAt     DateTime?
  bannedReason String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  businesses         Business[]          @relation("BusinessOwner")
  reviews            Review[]
  replies            ReviewReply[]
  claims             Claim[]             @relation("ClaimRequester")
  reviewedClaims     Claim[]             @relation("ClaimReviewer")
  reports            Report[]
  adminProfile       AdminUser?
  staffRoles         BusinessStaff[]
  customers          Customer[]
  reviewHelpfulVotes ReviewHelpfulVote[]
  legalAcceptances   LegalAcceptance[]

  @@index([role])
  @@index([status])
}

model Category {
  id       String  @id @default(cuid())
  slug     String  @unique
  nameUz   String
  nameRu   String
  nameEn   String
  parentId String?

  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  businesses Business[]

  @@index([parentId])
}

model Business {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  categoryId      String
  descriptionUz   String
  descriptionRu   String?
  descriptionEn   String?
  address         String
  district        String
  city            String         @default("Tashkent")
  lat             Decimal?       @db.Decimal(9, 6)
  lng             Decimal?       @db.Decimal(9, 6)
  phone           String?
  email           String?
  website         String?
  instagram       String?
  telegram        String?
  legalName       String?
  taxId           String? // STIR/INN — O'zbekiston soliq identifikatori
  hoursJson       Json?
  priceTier       String?
  status          BusinessStatus @default(unclaimed)
  claimedByUserId String?
  createdByUserId String?
  avgRating       Decimal        @default(0) @db.Decimal(3, 2)
  reviewCount     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  mergedIntoId       String?
  verificationStatus VerificationStatus @default(unverified)
  verifiedAt         DateTime?
  parentBusinessId   String? // multi-location under one account (Max)

  // Editorial curation for the landing page. Deliberately a manual flag rather
  // than an algorithmic score: at low business counts a ranked feed reads as
  // sparse, whereas a hand-picked row reads as intentional.
  featured  Boolean   @default(false)
  // When an owner actually took the listing over. Distinct from createdAt,
  // which is when the row was seeded — seeded listings would otherwise flood
  // "Just joined" with businesses that never joined anything.
  claimedAt DateTime?

  category         Category               @relation(fields: [categoryId], references: [id])
  claimedByUser    User?                  @relation("BusinessOwner", fields: [claimedByUserId], references: [id])
  mergedInto       Business?              @relation("BusinessMerge", fields: [mergedIntoId], references: [id])
  mergedFrom       Business[]             @relation("BusinessMerge")
  parent           Business?              @relation("BusinessLocations", fields: [parentBusinessId], references: [id])
  locations        Business[]             @relation("BusinessLocations")
  reviews          Review[]
  photos           Photo[]
  claims           Claim[]
  announcements    Announcement[]
  packages         BusinessPackage[]
  visits           BusinessVisit[]
  subscription     BusinessSubscription?
  staff            BusinessStaff[]
  events           BusinessEvent[]
  bookings         Booking[]
  payments         Payment[]
  verifications    BusinessVerification[]
  customers        Customer[]
  customerVisits   CustomerVisit[]
  legalAcceptances LegalAcceptance[]
  contracts        Contract[]
  campaigns        Campaign[]

  @@index([categoryId])
  @@index([city, district])
  @@index([status])
  @@index([avgRating, reviewCount])
  @@index([parentBusinessId])
}

model Review {
  id               String           @id @default(cuid())
  businessId       String
  userId           String
  rating           Int
  text             String
  // Denormalised tally of ReviewHelpfulVote. Kept as a column so review lists
  // do not need a per-row aggregate; the vote table is the source of truth.
  helpfulCount     Int              @default(0)
  moderationStatus ModerationStatus @default(approved)
  // Set when the review is traceable to a real booking, which is what makes a
  // "verified visit" badge meaningful rather than decorative. Unique so one
  // booking cannot be used to justify several reviews.
  bookingId        String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id])
  booking      Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  reply        ReviewReply?
  photos       Photo[]
  reports      Report[]
  helpfulVotes ReviewHelpfulVote[]

  @@unique([businessId, userId])
  @@index([businessId, createdAt])
  @@index([moderationStatus])
}

/**
 * One row per user per review. The unique constraint is the whole point: it is
 * what stops a single user inflating a review's helpful count by clicking
 * repeatedly, which is why the previous counter-only design was decorative.
 */
model ReviewHelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([userId])
}

model ReviewReply {
  id              String   @id @default(cuid())
  reviewId        String   @unique
  businessOwnerId String
  text            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  review        Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  businessOwner User   @relation(fields: [businessOwnerId], references: [id])
}

model Photo {
  id               String           @id @default(cuid())
  businessId       String?
  reviewId         String?
  storageKey       String
  publicUrl        String?
  moderationStatus ModerationStatus @default(pending)
  /// Whether this is the business's cover photo. No unique constraint on
  /// (businessId, isCover) — Postgres treats every `false` as distinct under a
  /// plain unique index, and a partial unique index isn't expressible in
  /// Prisma schema language — so single-cover is enforced by the repository
  /// inside a transaction: clear the current cover, then set the new one.
  isCover          Boolean          @default(false)
  createdAt        DateTime         @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  review   Review?   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reports  Report[]

  @@index([businessId])
  @@index([reviewId])
  @@index([moderationStatus])
  @@index([businessId, isCover])
}

model Claim {
  id                 String      @id @default(cuid())
  businessId         String
  userId             String
  verificationMethod String      @default("manual")
  status             ClaimStatus @default(pending)
  reviewedByAdminId  String?
  note               String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User     @relation("ClaimRequester", fields: [userId], references: [id])
  reviewedByAdmin User?    @relation("ClaimReviewer", fields: [reviewedByAdminId], references: [id])

  @@index([status])
  @@index([businessId])
}

model Announcement {
  id              String             @id @default(cuid())
  businessId      String
  kind            AnnouncementKind   @default(news)
  status          AnnouncementStatus @default(draft)
  title           String
  body            String
  discountPercent Int?
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model BusinessPackage {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(14, 2)
  currency    String   @default("UZS")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isActive])
}

model BusinessVisit {
  id         String   @id @default(cuid())
  businessId String
  visitorKey String
  source     String   @default("web")
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model Customer {
  id               String    @id @default(cuid())
  businessId       String
  userId           String?
  phone            String
  name             String?
  firstSeenAt      DateTime  @default(now())
  lastVisitAt      DateTime?
  visitCount       Int       @default(0)
  totalSpend       Decimal   @default(0) @db.Decimal(14, 2)
  loyaltyPoints    Int       @default(0)
  tags             String[]  @default([])
  notes            String?
  consentMarketing Boolean   @default(false)
  /// When marketing consent was captured. Null while consentMarketing is
  /// false — a consent record with no timestamp cannot be defended later.
  consentAt        DateTime?
  /// Birthday, for the birthday segment and campaign. Optional: most customers
  /// arrive through a booking that never asks for one.
  birthday         DateTime?
  /// Telegram chat id, set only if the customer starts a chat with the bot.
  /// Without it a Telegram campaign has no address to send to, which is why
  /// channel eligibility is computed per customer rather than assumed.
  telegramChatId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?           @relation(fields: [userId], references: [id])
  bookings      Booking[]
  visits        CustomerVisit[]
  campaignSends CampaignSend[]

  @@unique([businessId, phone])
  @@index([businessId, lastVisitAt])
  @@index([businessId, tags])
  @@index([userId])
}

model CustomerVisit {
  id         String   @id @default(cuid())
  businessId String
  customerId String
  bookingId  String?
  source     String   @default("booking_backfill")
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([bookingId])
  @@index([businessId, occurredAt])
  @@index([customerId, occurredAt])
}

model BusinessSubscription {
  id                String             @id @default(cuid())
  businessId        String             @unique
  plan              PlanTier           @default(free)
  status            SubscriptionStatus @default(active)
  startedAt         DateTime           @default(now())
  renewsAt          DateTime?
  provider          PaymentProvider?
  externalId        String?
  /// Stripe customer and subscription ids, when provider = stripe. Kept as
  /// distinct columns rather than reusing externalId because reconciling a
  /// subscription needs both, and a webhook arrives keyed on either one.
  stripeCustomerId     String?
  stripeSubscriptionId String? @unique
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Report {
  id             String       @id @default(cuid())
  reporterUserId String
  reviewId       String?
  photoId        String?
  reason         String
  status         ReportStatus @default(open)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter User    @relation(fields: [reporterUserId], references: [id])
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  photo    Photo?  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reviewId])
  @@index([photoId])
}

// ============================================================
// Admin platform — RBAC, audit, feature flags
// ============================================================

model AdminUser {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  userId      String?   @unique
  email       String    @unique
  name        String
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User?           @relation(fields: [userId], references: [id])
  roles     AdminUserRole[]
  auditLogs AuditLog[]

  @@index([isActive])
}

model Role {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  admins      AdminUserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  slug        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([category])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AdminUserRole {
  adminUserId       String
  roleId            String
  assignedByAdminId String?
  assignedAt        DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@index([roleId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  action      String
  targetType  String
  targetId    String?
  beforeState Json?
  afterState  Json?
  reason      String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor AdminUser @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model FeatureFlag {
  id               String   @id @default(cuid())
  key              String   @unique
  description      String?
  enabled          Boolean  @default(false)
  cityScope        String?
  localeScope      String?
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================================
// Business platform — plans, entitlements, team, verification,
// analytics, bookings, payments
// ============================================================

// Dynamic, admin-editable pricing. Source of truth for the public pricing
// page, plan selection, and server-side entitlement checks.
model Plan {
  id            String   @id @default(cuid())
  tier          PlanTier @unique
  nameUz        String
  nameRu        String
  nameEn        String
  priceMonthly  Decimal  @default(0) @db.Decimal(14, 2)
  priceYearly   Decimal? @db.Decimal(14, 2)
  currency      String   @default("UZS")
  photoLimit    Int? // null = unlimited
  staffLimit    Int      @default(1)
  locationLimit Int      @default(1)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  /// Price charged through Stripe, in USD cents.
  ///
  /// Held separately from priceMonthly rather than converted from it: the
  /// Stripe account is US/USD and cannot charge UZS, and deriving the dollar
  /// figure from an exchange rate would let the published price drift without
  /// anyone deciding to change it. Null means the tier is not purchasable
  /// through Stripe (the free tier).
  priceMonthlyUsdCents Int?
  /// Stripe Price id for priceMonthlyUsdCents. Set by the sync script; null
  /// until the tier has been mirrored into Stripe.
  stripePriceId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  features PlanFeature[]
}

model PlanFeature {
  id       String  @id @default(cuid())
  planId   String
  key      String // entitlement key, e.g. analytics.advanced, booking, telegram.bot
  labelUz  String?
  labelRu  String?
  labelEn  String?
  included Boolean @default(true)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([key])
}

model BusinessStaff {
  id              String    @id @default(cuid())
  businessId      String
  userId          String?
  phone           String
  role            StaffRole @default(staff)
  invitedByUserId String?
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@unique([businessId, phone])
  @@index([userId])
}

model PhoneVerification {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("register")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
}

model BusinessVerification {
  id                String             @id @default(cuid())
  businessId        String
  method            VerificationMethod
  status            VerificationStatus @default(pending)
  taxId             String?
  documentUrl       String?
  reviewedByAdminId String?
  note              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([status])
}

model BusinessEvent {
  id         String            @id @default(cuid())
  businessId String
  type       BusinessEventType
  visitorKey String?
  source     String            @default("web")
  createdAt  DateTime          @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, type, createdAt])
}

model SearchQueryLog {
  id                String   @id @default(cuid())
  query             String
  district          String?
  categorySlug      String?
  resultCount       Int
  clickedBusinessId String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([resultCount])
}

model Booking {
  id             String        @id @default(cuid())
  businessId     String
  customerId     String?
  customerUserId String?
  customerPhone  String
  serviceName    String
  startsAt       DateTime
  endsAt         DateTime?
  status         BookingStatus @default(pending)
  depositAmount  Decimal?      @db.Decimal(14, 2)
  paymentId      String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id])
  payment       Payment?       @relation(fields: [paymentId], references: [id])
  customerVisit CustomerVisit?
  review        Review?

  @@index([businessId, startsAt])
  @@index([customerId])
}

model Payment {
  id         String          @id @default(cuid())
  businessId String
  provider   PaymentProvider
  purpose    String // subscription | booking_deposit
  amount     Decimal         @db.Decimal(14, 2)
  currency   String          @default("UZS")
  status     PaymentStatus   @default(pending)
  externalId String?
  rawPayload Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking  Booking?

  @@index([businessId, status])
  @@index([provider, externalId])
}

/// Kind of legal document a business must accept.
enum LegalDocumentKind {
  terms_of_service
  privacy_policy
  contract_template
}

/**
 * A published, versioned legal document.
 * Versioned rather than edited in place because acceptance has to point at the
 * exact text the business agreed to. Editing a live document would silently
 * rewrite what every prior acceptance means, which is the failure mode that
 * makes an acceptance record worthless in a dispute.
 */
model LegalDocument {
  id          String            @id @default(cuid())
  kind        LegalDocumentKind
  /// Human-facing version label, e.g. "1.0", "2026-07".
  version     String
  locale      String            @default("uz")
  title       String
  /// Full document body (markdown). Immutable once published.
  body        String
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  acceptances LegalAcceptance[]
  contracts   Contract[]

  @@unique([kind, version, locale])
  @@index([kind, publishedAt])
}

/**
 * Records that a specific user accepted a specific document version on behalf
 * of a business. IP and user agent are captured because an acceptance without
 * provenance is difficult to rely on later.
 */
model LegalAcceptance {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  documentId String
  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id])
  document LegalDocument @relation(fields: [documentId], references: [id])

  // One acceptance per business per document version; re-accepting the same
  // version is a no-op rather than a duplicate row.
  @@unique([businessId, documentId])
  @@index([businessId, acceptedAt])
  @@index([documentId])
}

/**
 * A contract generated for a business at the moment it accepted the template.
 * `renderedBody` is stored rather than re-rendered on download: regenerating
 * from a template that may have changed since would hand the business a
 * document they never agreed to.
 */
model Contract {
  id           String   @id @default(cuid())
  businessId   String
  documentId   String
  /// Human-facing contract number shown on the document.
  contractNo   String   @unique
  /// Frozen contract text as generated at acceptance time.
  renderedBody String
  /// Storage key if a PDF was rendered and uploaded; null while text-only.
  storageKey   String?
  generatedAt  DateTime @default(now())

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  document LegalDocument @relation(fields: [documentId], references: [id])

  @@index([businessId, generatedAt])
}

/// Lifecycle trigger that causes a campaign to fire.
enum CampaignTrigger {
  welcome /// first completed booking
  win_back /// N days since last visit
  birthday /// on/near the customer's birthday
  review_request /// after a completed visit
}

enum CampaignChannel {
  telegram
  sms
}

enum CampaignSendStatus {
  pending
  sent
  failed
  /// Consent was absent or withdrawn at send time. A distinct status rather
  /// than a failure, because it is the system working correctly.
  blocked_no_consent
  /// The customer had no address on the chosen channel.
  blocked_no_channel
}

/**
 * An automated, trigger-based campaign for one business.
 * Triggers rather than manual blasts: the CRM brief's Square/Toast pattern, and
 * the reason a small owner gets value without operating a marketing tool.
 */
model Campaign {
  id         String          @id @default(cuid())
  businessId String
  name       String
  trigger    CampaignTrigger
  channel    CampaignChannel
  /// Message body. {{name}} and {{business}} are substituted at send time.
  template   String
  /// Days since last visit, for win_back. Ignored by other triggers.
  windowDays Int?
  isActive   Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sends    CampaignSend[]

  @@index([businessId, isActive])
  @@index([trigger])
}

/**
 * One attempted send. Written for blocked attempts too, not just successful
 * ones — the record that a message was *withheld* for lack of consent is the
 * evidence that matters under a personal-data regime, and a table containing
 * only successes cannot show it.
 */
model CampaignSend {
  id            String             @id @default(cuid())
  campaignId    String
  customerId    String
  status        CampaignSendStatus @default(pending)
  channel       CampaignChannel
  /// Rendered message as actually sent, frozen — the template may change later.
  body          String?
  error         String?
  /// Consent flag as it stood at send time, captured rather than re-read later.
  consentAtSend Boolean            @default(false)
  createdAt     DateTime           @default(now())
  sentAt        DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// One send per campaign per customer: the guard against a win-back loop
  /// re-messaging the same lapsed customer on every scheduler tick.
  @@unique([campaignId, customerId])
  @@index([campaignId, status])
  @@index([customerId])
}

enum WaitlistTopic {
  city
  gurman
  pro
}

model WaitlistSignup {
  id           String        @id @default(cuid())
  topic        WaitlistTopic
  email        String
  locale       String        @default("uz")
  /// Only set for topic=city. The whole point of the city waitlist is knowing
  /// which city to open next, so a signup without one carries no information.
  city         String?
  /// Only set for topic=pro, and only when the signup came from an owner who
  /// already has a business.
  businessName String?
  /// Which page the signup came from, for attribution.
  source       String?
  createdAt    DateTime      @default(now())

  /// One signup per email per topic. A person re-submitting the Gurman form
  /// should not create a second queue entry and jump their own position.
  @@unique([topic, email])
  @@index([topic, createdAt])
  @@index([topic, city])
}
