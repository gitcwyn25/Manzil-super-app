generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  consumer
  business_owner
  admin
}

enum BusinessStatus {
  unclaimed
  pending_claim
  claimed
  suspended
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum ClaimStatus {
  pending
  approved
  rejected
}

enum ReportStatus {
  open
  resolved
  rejected
}

enum AnnouncementKind {
  news
  discount
  broadcast
}

enum AnnouncementStatus {
  draft
  published
  archived
}

enum PlanTier {
  free
  pro
  max
}

enum SubscriptionStatus {
  trial
  active
  invoice_pending
  canceled
}

enum UserStatus {
  active
  suspended
  banned
}

enum StaffRole {
  owner
  manager
  staff
}

enum PaymentProvider {
  payme
  click
  uzcard
  card
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum BookingStatus {
  pending
  confirmed
  canceled
  completed
  no_show
}

enum VerificationMethod {
  stir
  document
  phone
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum BusinessEventType {
  view
  call
  directions
  message
  photo_view
}

model User {
  id          String     @id @default(cuid())
  clerkId     String?    @unique
  email       String?    @unique
  phone       String?    @unique
  displayName String
  avatarUrl   String?
  locale      String     @default("uz")
  role        UserRole   @default(consumer)
  status      UserStatus @default(active)
  bannedAt    DateTime?
  bannedReason String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  businesses     Business[] @relation("BusinessOwner")
  reviews        Review[]
  replies        ReviewReply[]
  claims         Claim[] @relation("ClaimRequester")
  reviewedClaims Claim[] @relation("ClaimReviewer")
  reports        Report[]
  adminProfile   AdminUser?
  staffRoles     BusinessStaff[]
  customers      Customer[]

  @@index([role])
  @@index([status])
}

model Category {
  id       String  @id @default(cuid())
  slug     String  @unique
  nameUz   String
  nameRu   String
  nameEn   String
  parentId String?

  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  businesses Business[]

  @@index([parentId])
}

model Business {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  categoryId      String
  descriptionUz   String
  descriptionRu   String?
  descriptionEn   String?
  address         String
  district        String
  city            String         @default("Tashkent")
  lat             Decimal?       @db.Decimal(9, 6)
  lng             Decimal?       @db.Decimal(9, 6)
  phone           String?
  email           String?
  website         String?
  instagram       String?
  telegram        String?
  legalName       String?
  taxId           String?        // STIR/INN — O'zbekiston soliq identifikatori
  hoursJson       Json?
  priceTier       String?
  status          BusinessStatus @default(unclaimed)
  claimedByUserId String?
  createdByUserId String?
  avgRating       Decimal        @default(0) @db.Decimal(3, 2)
  reviewCount     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  mergedIntoId       String?
  verificationStatus VerificationStatus @default(unverified)
  verifiedAt         DateTime?
  parentBusinessId   String?             // multi-location under one account (Max)

  category      Category @relation(fields: [categoryId], references: [id])
  claimedByUser User?    @relation("BusinessOwner", fields: [claimedByUserId], references: [id])
  mergedInto    Business?  @relation("BusinessMerge", fields: [mergedIntoId], references: [id])
  mergedFrom    Business[] @relation("BusinessMerge")
  parent        Business?  @relation("BusinessLocations", fields: [parentBusinessId], references: [id])
  locations     Business[] @relation("BusinessLocations")
  reviews       Review[]
  photos        Photo[]
  claims        Claim[]
  announcements Announcement[]
  packages      BusinessPackage[]
  visits        BusinessVisit[]
  subscription  BusinessSubscription?
  staff         BusinessStaff[]
  events        BusinessEvent[]
  bookings      Booking[]
  payments      Payment[]
  verifications BusinessVerification[]
  customers     Customer[]
  customerVisits CustomerVisit[]

  @@index([categoryId])
  @@index([city, district])
  @@index([status])
  @@index([avgRating, reviewCount])
  @@index([parentBusinessId])
}

model Review {
  id             String   @id @default(cuid())
  businessId     String
  userId         String
  rating         Int
  text           String
  helpfulCount   Int      @default(0)
  moderationStatus ModerationStatus @default(approved)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id])
  reply    ReviewReply?
  photos   Photo[]
  reports  Report[]

  @@unique([businessId, userId])
  @@index([businessId, createdAt])
  @@index([moderationStatus])
}

model ReviewReply {
  id              String   @id @default(cuid())
  reviewId        String   @unique
  businessOwnerId String
  text            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  review        Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  businessOwner User   @relation(fields: [businessOwnerId], references: [id])
}

model Photo {
  id               String           @id @default(cuid())
  businessId        String?
  reviewId          String?
  storageKey        String
  publicUrl         String?
  moderationStatus  ModerationStatus @default(pending)
  createdAt         DateTime         @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  review   Review?   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reports  Report[]

  @@index([businessId])
  @@index([reviewId])
  @@index([moderationStatus])
}

model Claim {
  id                String      @id @default(cuid())
  businessId        String
  userId            String
  verificationMethod String     @default("manual")
  status            ClaimStatus @default(pending)
  reviewedByAdminId String?
  note              String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User     @relation("ClaimRequester", fields: [userId], references: [id])
  reviewedByAdmin User?    @relation("ClaimReviewer", fields: [reviewedByAdminId], references: [id])

  @@index([status])
  @@index([businessId])
}

model Announcement {
  id              String             @id @default(cuid())
  businessId      String
  kind            AnnouncementKind   @default(news)
  status          AnnouncementStatus @default(draft)
  title           String
  body            String
  discountPercent Int?
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model BusinessPackage {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(14, 2)
  currency    String   @default("UZS")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isActive])
}

model BusinessVisit {
  id         String   @id @default(cuid())
  businessId String
  visitorKey String
  source     String   @default("web")
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model Customer {
  id               String   @id @default(cuid())
  businessId       String
  userId           String?
  phone            String
  name             String?
  firstSeenAt      DateTime @default(now())
  lastVisitAt      DateTime?
  visitCount       Int      @default(0)
  totalSpend       Decimal  @default(0) @db.Decimal(14, 2)
  loyaltyPoints    Int      @default(0)
  tags             String[] @default([])
  notes            String?
  consentMarketing Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])
  bookings Booking[]
  visits   CustomerVisit[]

  @@unique([businessId, phone])
  @@index([businessId, lastVisitAt])
  @@index([businessId, tags])
  @@index([userId])
}

model CustomerVisit {
  id         String   @id @default(cuid())
  businessId String
  customerId String
  bookingId  String?
  source     String   @default("booking_backfill")
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([bookingId])
  @@index([businessId, occurredAt])
  @@index([customerId, occurredAt])
}

model BusinessSubscription {
  id                String             @id @default(cuid())
  businessId        String             @unique
  plan              PlanTier           @default(free)
  status            SubscriptionStatus @default(active)
  startedAt         DateTime           @default(now())
  renewsAt          DateTime?
  provider          PaymentProvider?
  externalId        String?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Report {
  id             String       @id @default(cuid())
  reporterUserId String
  reviewId       String?
  photoId        String?
  reason         String
  status         ReportStatus @default(open)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter User   @relation(fields: [reporterUserId], references: [id])
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  photo    Photo?  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reviewId])
  @@index([photoId])
}

// ============================================================
// Admin platform — RBAC, audit, feature flags
// ============================================================

model AdminUser {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  userId      String?   @unique
  email       String    @unique
  name        String
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User?           @relation(fields: [userId], references: [id])
  roles     AdminUserRole[]
  auditLogs AuditLog[]

  @@index([isActive])
}

model Role {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  admins      AdminUserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  slug        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([category])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AdminUserRole {
  adminUserId       String
  roleId            String
  assignedByAdminId String?
  assignedAt        DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@index([roleId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  action      String
  targetType  String
  targetId    String?
  beforeState Json?
  afterState  Json?
  reason      String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor AdminUser @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model FeatureFlag {
  id               String   @id @default(cuid())
  key              String   @unique
  description      String?
  enabled          Boolean  @default(false)
  cityScope        String?
  localeScope      String?
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================================
// Business platform — plans, entitlements, team, verification,
// analytics, bookings, payments
// ============================================================

// Dynamic, admin-editable pricing. Source of truth for the public pricing
// page, plan selection, and server-side entitlement checks.
model Plan {
  id            String   @id @default(cuid())
  tier          PlanTier @unique
  nameUz        String
  nameRu        String
  nameEn        String
  priceMonthly  Decimal  @default(0) @db.Decimal(14, 2)
  priceYearly   Decimal? @db.Decimal(14, 2)
  currency      String   @default("UZS")
  photoLimit    Int? // null = unlimited
  staffLimit    Int      @default(1)
  locationLimit Int      @default(1)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  features PlanFeature[]
}

model PlanFeature {
  id       String  @id @default(cuid())
  planId   String
  key      String // entitlement key, e.g. analytics.advanced, booking, telegram.bot
  labelUz  String?
  labelRu  String?
  labelEn  String?
  included Boolean @default(true)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([key])
}

model BusinessStaff {
  id              String    @id @default(cuid())
  businessId      String
  userId          String?
  phone           String
  role            StaffRole @default(staff)
  invitedByUserId String?
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@unique([businessId, phone])
  @@index([userId])
}

model PhoneVerification {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("register")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
}

model BusinessVerification {
  id                String             @id @default(cuid())
  businessId        String
  method            VerificationMethod
  status            VerificationStatus @default(pending)
  taxId             String?
  documentUrl       String?
  reviewedByAdminId String?
  note              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([status])
}

model BusinessEvent {
  id         String            @id @default(cuid())
  businessId String
  type       BusinessEventType
  visitorKey String?
  source     String            @default("web")
  createdAt  DateTime          @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, type, createdAt])
}

model SearchQueryLog {
  id                String   @id @default(cuid())
  query             String
  district          String?
  categorySlug      String?
  resultCount       Int
  clickedBusinessId String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([resultCount])
}

model Booking {
  id             String        @id @default(cuid())
  businessId     String
  customerId     String?
  customerUserId String?
  customerPhone  String
  serviceName    String
  startsAt       DateTime
  endsAt         DateTime?
  status         BookingStatus @default(pending)
  depositAmount  Decimal?      @db.Decimal(14, 2)
  paymentId      String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
  payment  Payment? @relation(fields: [paymentId], references: [id])
  customerVisit CustomerVisit?

  @@index([businessId, startsAt])
  @@index([customerId])
}

model Payment {
  id         String          @id @default(cuid())
  businessId String
  provider   PaymentProvider
  purpose    String // subscription | booking_deposit
  amount     Decimal         @db.Decimal(14, 2)
  currency   String          @default("UZS")
  status     PaymentStatus   @default(pending)
  externalId String?
  rawPayload Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking  Booking?

  @@index([businessId, status])
  @@index([provider, externalId])
}
