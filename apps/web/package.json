    "framer-motion": "^11.18.2",
    "next": "*",
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^26.1.1",
    "@types/react": "*",
    "@types/react-dom": "*",
    "autoprefixer": "^10.5.4",
    "cross-env": "*",
    "eslint": "^9.30.1",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^3.4.17",
    "typescript": "*"
