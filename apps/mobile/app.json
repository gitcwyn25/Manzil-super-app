{
  "expo": {
    "name": "Manzil",
    "slug": "manzil-android-app",
    "owner": "manzil-group",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.manzil.consumer",
      "versionCode": 1,
      "backgroundColor": "#F9F9F7",
