{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "redirects": [
    { "source": "/en/privacy", "destination": "/en/legal/privacy", "permanent": true },
    { "source": "/en/terms", "destination": "/en/legal/terms", "permanent": true },
    { "source": "/en/review-rules", "destination": "/en/legal/reviews", "permanent": true },
    {
      "source": "/en/waitlist/gurman",
      "destination": "https://manzil-business.vercel.app/en/waitlist/gurman",
      "permanent": false
    },
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/uz", "destination": "/", "permanent": true },
    { "source": "/ru", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
